---
import MetaPage from "@/components/MetaPage.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import Layout from "@/layouts/Layout.astro"
import { getCollection } from "astro:content"

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort(
  (a, b) =>
    (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0),
)
---

<Layout>
  <MetaPage slot="head" title="Projects" />
  <h1 class="typewriter">Projects</h1>
  {
    projects.length > 0 ? (
      <ul>
        {projects.map((project) => <ProjectCard project={project} />)}
      </ul>
    ) : (
      <p class="empty">
        Project in progress :3c... You will see them as soon as I have a write
        up!
      </p>
    )
  }
</Layout>

<style>
  h1 {
    font-size: var(--step-6);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
    margin-block-end: var(--space-m);

    &.typewriter {
      display: block;
      overflow: hidden;
      white-space: nowrap;
      border-right: 5px solid var(--primary);
      width: 6.3ch;
      animation:
        type 0.6s ease-out forwards,
        blink-caret 0.75s step-end infinite;
    }
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .empty {
    font-size: var(--step-0);
    color: var(--muted-foreground);
  }

  @keyframes type {
    from { width: 0; }
    to   { width: 6.3ch; }
  }

  @keyframes blink-caret {
    50% { border-color: transparent; }
  }
</style>